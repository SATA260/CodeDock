# 复制为 .env 后按需修改。未设置的项使用括号中的默认值。

# HTTP 监听地址（默认 :8080）
HTTP_ADDR=:8080

# 日志级别：debug | info | warn | error（默认 debug）
LOG_LEVEL=debug

# 数据库引擎：sqlite | postgres（当前只实现 sqlite，默认 sqlite）
DB_ENGINE=sqlite

# 数据库连接串。未设且引擎为 sqlite 时默认 <仓根>/data/codedock.db
# DB_DSN=file:/abs/path/data/codedock.db

# 模型提供方：fake | openai（默认 fake，测试与离线闭环用）
LLM_PROVIDER=fake

# 模型名（默认 fake）
LLM_MODEL=fake

# OpenAI 兼容 API Key（provider=openai 时必填）
LLM_API_KEY=

# OpenAI 兼容 Base URL，例如 https://api.openai.com/v1（可空）
LLM_BASE_URL=

# 思考开关：enabled | disabled。空则沿用模型默认（DeepSeek 当前默认开启）
# LLM_THINKING=

# 单次回复输出 token 上限，思考和正文共用（默认 65536）
# LLM_MAX_OUTPUT_TOKENS=65536

# 单次 Run 输入 token 上限，含上下文（默认 256000）
# LLM_MAX_INPUT_TOKENS=256000

# 单次 Run 最多模型轮数（默认 32）
# LLM_MAX_TURNS=32

# 单次 Run 最多工具调用次数（默认 64）
# LLM_MAX_TOOL_CALLS=64

# 单次 Run 墙钟上限（默认 20m）
# LLM_MAX_WALL_TIME=20m

# 本地 Git 仓库根。未设则用进程 cwd（从 server/ 启动时 cwd 不是仓根）。
# 撤回会改磁盘。本地试用先跑 scripts/git-sandbox.sh，再把这里指到 tmp/git-sandbox。
# 要操作本仓时显式写成仓根。pnpm dev:api 在沙箱存在时默认用沙箱。
GIT_REPO=

# 插件目录。每个子目录放一个与目录同名的二进制。未设则不拉插件进程。
# 示例：编译 plugin/redact 后设 PLUGIN_DIR=<仓根>/plugin
# PLUGIN_DIR=

# 单次插件 RPC 超时（默认 10s）
# PLUGIN_RPC_TIMEOUT=10s

# 本机 Codex CLI 可执行文件（默认 codex）。未安装时主服务仍可启动，/codex/status 会说明原因。
CODEX_BIN=codex

