# 复制为 .env 后按需修改。未设置的项使用括号中的默认值。

# HTTP 监听地址（默认 :8080）
HTTP_ADDR=:8080

# 日志级别：debug | info | warn | error（默认 debug）
LOG_LEVEL=debug

# 数据库引擎：sqlite | postgres（当前只实现 sqlite，默认 sqlite）
DB_ENGINE=sqlite

# 数据库连接串（默认 file:codedock.db）
DB_DSN=file:codedock.db

# 模型提供方：fake | openai（默认 fake，测试与离线闭环用）
LLM_PROVIDER=fake

# 模型名（默认 fake）
LLM_MODEL=fake

# OpenAI 兼容 API Key（provider=openai 时必填）
LLM_API_KEY=

# OpenAI 兼容 Base URL，例如 https://api.openai.com/v1（可空）
LLM_BASE_URL=
